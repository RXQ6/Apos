    { "code": "ITEM_OFF_SHELF", "next": "catalog.detail" }
  ],
  "docs": {
    "scenario": "features/cart.add/SCENARIO.md",
    "modules": ["modules/cart/MODULE.md"]
  },
  "harness": {
