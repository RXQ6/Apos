      "next": "payment.callback"
    }
  ],
  "docs": {
    "scenario": "features/payment.timeout_close/SCENARIO.md",
    "spec": "docs/compose/spec/ecommerce-scenario-routing.md",
    "modules": [
      "modules/payment/ROUTING.md"
    ]
  },
  "harness": {
