  ],
  "errors": [
    { "code": "LINE_INVALID", "next": "cart.update" }
  ],
  "docs": {
    "scenario": "features/cart.checkout_ready/SCENARIO.md",
    "modules": ["modules/cart/ROUTING.md", "modules/order/ROUTING.md"]
  },
  "harness": {
    "status": "not_started",
    "verify": "docs:verify"
  }
