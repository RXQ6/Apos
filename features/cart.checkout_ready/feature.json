  "summary": "勾选行校验通过并生成 checkout_batch，作为创建订单前置。",
  "status": "designed",
  "domain": "cart",
  "kind": "happy-path",
  "priority": "P0",
  "actors": ["buyer", "system"],
  "modules": {
    "primary": "cart",
    "involved": ["cart", "catalog", "order"]
  },
