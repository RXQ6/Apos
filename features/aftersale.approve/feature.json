  "states": { "before": ["opened"], "after": ["approved", "rejected"] },
  "acceptance": ["状态迁移合法", "拒绝需原因", "重复审核幂等"],
  "errors": [{ "code": "AFTERSALE_STATE_INVALID", "next": "order.get" }],
  "docs": {
    "scenario": "features/aftersale.approve/SCENARIO.md",
    "modules": ["modules/aftersale/MODULE.md"]
  },
  "harness": { "status": "not_started", "verify": "docs:verify" }
