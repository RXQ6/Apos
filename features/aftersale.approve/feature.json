{
  "id": "aftersale.approve",
  "title": "售后审核",
  "summary": "客服/系统审核售后单，通过后进入退款或退货流程。",
  "status": "designed",
  "domain": "aftersale",
  "kind": "happy-path",
  "priority": "P0",
  "actors": ["admin", "system"],
